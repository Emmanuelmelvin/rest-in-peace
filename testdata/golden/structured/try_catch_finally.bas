' TRY … CATCH e … FINALLY … END TRY, and what e exposes.
TRY
  PRINT "OPENING THE CRYPT"
  THROW ERROR("THE CRYPT IS SEALED")
  PRINT "NEVER"
CATCH e
  PRINT e.kind; " "; e.message
  PRINT e.file; ":"; e.line
  PRINT e.status = NIL
FINALLY
  PRINT "CLOSING THE CRYPT"
END TRY

TRY
  PRINT "NOTHING WENT WRONG"
CATCH e
  PRINT "NEVER"
FINALLY
  PRINT "FINALLY RUNS ANYWAY"
END TRY
PRINT "AFTER"
