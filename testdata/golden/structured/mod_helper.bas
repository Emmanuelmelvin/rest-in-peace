EXPORT CONST TAX_RATE = DECIMAL("0.10")
EXPORT CONST LABEL = "TOTAL"

FUNCTION secretHelper(x)
  RETURN x * 2
END FUNCTION

EXPORT FUNCTION CalcTax(amount)
  RETURN ROUND(DECIMAL(amount) * TAX_RATE, 2)
END FUNCTION

EXPORT FUNCTION CalcTotal(amount)
  RETURN DECIMAL(amount) + CalcTax(amount)
END FUNCTION

EXPORT SUB Greet(name)
  PRINT "HELLO, " & name
END SUB
