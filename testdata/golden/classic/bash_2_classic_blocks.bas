10 REM Classic mode block control flow: FOR EACH, SELECT CASE, WHILE/EXIT, DO/LOOP UNTIL, IF/ELSEIF/ELSE (Requirement 2.1, 2.2)
20 LET ITEMS = ["a", "b", "c"]
30 LET JOINED = ""
40 FOR EACH X IN ITEMS
50   JOINED = JOINED & X
60 NEXT
70 PRINT JOINED
80 LET N = 2
90 SELECT CASE N
100   CASE 1
110     PRINT "one"
120   CASE 2, 3
130     PRINT "two-or-three"
140   CASE ELSE
150     PRINT "other"
160 END SELECT
170 LET I = 0
180 WHILE I < 10
190   I = I + 1
200   IF I = 3 THEN EXIT WHILE
210 WEND
220 PRINT I
230 LET J = 0
240 DO
250   J = J + 1
260 LOOP UNTIL J = 4
270 PRINT J
280 IF J < 2 THEN
290   PRINT "low"
300 ELSEIF J = 4 THEN
310   PRINT "exact"
320 ELSE
330   PRINT "high"
340 END IF
350 GOSUB 500
360 END
500 PRINT "sub-ok"
510 RETURN
