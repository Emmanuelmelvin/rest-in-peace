{
  "comments": {
    "lineComment": "'"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|-?\\d*\\.?\\d+(?:[eE][+-]?\\d+)?",
  "indentationRules": {
    "increaseIndentPattern": {
      "pattern": "^\\s*(?:\\d+\\s+)?(?:(?:EXPORT\\s+)?(?:FUNCTION|SUB)\\b|IF\\b.*\\bTHEN\\s*(?:'.*)?$|ELSEIF\\b.*\\bTHEN\\s*(?:'.*)?$|ELSE\\s*(?:'.*)?$|FOR\\b|WHILE\\b|DO\\b|SELECT\\s+CASE\\b|CASE\\b|TRY\\b|CATCH\\b|FINALLY\\b|ROUTE\\s+GROUP\\b|TRANSACTION\\b|TEST\\b)",
      "flags": "i"
    },
    "decreaseIndentPattern": {
      "pattern": "^\\s*(?:\\d+\\s+)?(?:END\\b|NEXT\\b|WEND\\b|LOOP\\b|ELSE\\b|ELSEIF\\b|CASE\\b|CATCH\\b|FINALLY\\b)",
      "flags": "i"
    }
  }
}
