{
  "name": "rip-basic",
  "displayName": "RIP BASIC",
  "description": "Syntax highlighting, editing support and file icons for RIP BASIC (.bas and .test.bas) files.",
  "version": "0.2.0",
  "publisher": "rest-in-peace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emmanuelmelvin/rest-in-peace.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "basic",
    "bas",
    "rip"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ripbasic",
        "aliases": [
          "RIP BASIC",
          "ripbasic"
        ],
        "extensions": [
          ".bas"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/bas.svg",
          "dark": "./icons/bas.svg"
        }
      },
      {
        "id": "ripbasic-test",
        "aliases": [
          "RIP BASIC Test",
          "ripbasic-test"
        ],
        "extensions": [
          ".test.bas"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/bas-test.svg",
          "dark": "./icons/bas-test.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ripbasic",
        "scopeName": "source.ripbasic",
        "path": "./syntaxes/ripbasic.tmLanguage.json"
      },
      {
        "language": "ripbasic-test",
        "scopeName": "source.ripbasic.test",
        "path": "./syntaxes/ripbasic-test.tmLanguage.json"
      }
    ]
  }
}
